diff --git a/node_modules/react-native-bare-kit/ios/link.mjs b/node_modules/react-native-bare-kit/ios/link.mjs
index 6c89b18..3d94950 100644
--- a/node_modules/react-native-bare-kit/ios/link.mjs
+++ b/node_modules/react-native-bare-kit/ios/link.mjs
@@ -1,12 +1,28 @@
+import fs from 'fs'
 import path from 'path'
 import { fileURLToPath } from 'url'
 import link from 'bare-link'

 const __filename = fileURLToPath(import.meta.url)

+const out = path.join(__filename, '..', 'addons')
+
+// Clean the output directory before linking. bare-link writes the addon versions
+// resolved from the app's node_modules but never removes frameworks already
+// present -- including the older versions prebuilt into this package (e.g.
+// udx-native.1.19.2) and stale versions left behind by previous builds (e.g. a
+// leftover bare-os.3.7.1). The podspec vendors `ios/addons/*.xcframework`
+// wholesale, so every leftover gets embedded into the .app. Two versions of the
+// same Bare addon then load into a single process and corrupt the addon's shared
+// registration state -> EXC_BAD_ACCESS at runtime (the udx-native crash), or a
+// dangling exact-version @rpath dependency -> dyld "Library not loaded" on
+// launch. Wiping first lets bare-link produce one self-consistent set.
+fs.rmSync(out, { recursive: true, force: true })
+fs.mkdirSync(out, { recursive: true })
+
 for await (const resource of link(path.join(__filename, '..', '..', '..', '..'), {
   target: ['ios-arm64', 'ios-arm64-simulator', 'ios-x64-simulator'],
-  out: path.join(__filename, '..', 'addons')
+  out
 })) {
   console.log('Wrote', resource)
 }
